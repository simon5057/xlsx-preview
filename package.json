{
  "name": "xlsx-preview",
  "version": "1.0.5",
  "description": "Preview the .xlsx in the browser, convert to HTML with styles.",
  "main": "dist/xlsxPreview.cjs",
  "module": "dist/xlsxPreview.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/xlsxPreview.iife.js",
      "import": "./dist/xlsxPreview.mjs",
      "require": "./dist/xlsxPreview.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "tslint --project ."
  },
  "pre-commit": [
    "lint"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nslyc/xlsx-preview.git"
  },
  "keywords": [
    "xlsx",
    "html",
    "xlsx-preview"
  ],
  "author": "nslyc",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nslyc/xlsx-preview/issues"
  },
  "homepage": "https://github.com/nslyc/xlsx-preview#readme",
  "dependencies": {
    "exceljs": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tslint": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
